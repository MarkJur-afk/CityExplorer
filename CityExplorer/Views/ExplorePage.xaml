<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CityExplorer.ViewModels"
             xmlns:models="clr-namespace:CityExplorer.Models"
             xmlns:strings="clr-namespace:CityExplorer.Resources.Strings"
             x:Class="CityExplorer.Views.ExplorePage"
             Title="{Binding [ExploreTitle], Source={x:Static strings:LocalizationResourceManager.Instance}}">

    <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="*, Auto" Padding="10">

        <!-- Header / Emoji Menu -->
        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="15" HorizontalOptions="Center" Margin="0,10,0,20">
            <Button Text="Всё" Command="{Binding CategorySelectedCommand}" CommandParameter="Всё" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontSize="18"/>
            <Button Text="🏰" Command="{Binding CategorySelectedCommand}" CommandParameter="🏰" BackgroundColor="Transparent" FontSize="24"/>
            <Button Text="🌳" Command="{Binding CategorySelectedCommand}" CommandParameter="🌳" BackgroundColor="Transparent" FontSize="24"/>
            <Button Text="🗼" Command="{Binding CategorySelectedCommand}" CommandParameter="🗼" BackgroundColor="Transparent" FontSize="24"/>
            <Button Text="🚢" Command="{Binding CategorySelectedCommand}" CommandParameter="🚢" BackgroundColor="Transparent" FontSize="24"/>
        </HorizontalStackLayout>

        <!-- Carousel -->
        <CarouselView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      ItemsSource="{Binding FilteredAttractions}"
                      IndicatorView="indicatorView"
                      CurrentItem="{Binding SelectedAttraction}"
                      PeekAreaInsets="40">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:Attraction">
                    <Frame Margin="10" CornerRadius="20" HasShadow="True" Padding="0" IsClippedToBounds="True">
                        <Grid RowDefinitions="*, Auto">
                            <Image Grid.Row="0" Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="300"/>
                            <StackLayout Grid.Row="1" Padding="15" BackgroundColor="{AppThemeBinding Light=#EEFFFFFF, Dark=#EE000000}">
                                <Label Text="{Binding Name}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="{Binding Category}" FontSize="24" HorizontalOptions="Center" Margin="0,5,0,0"/>
                                <Label Text="{Binding Description}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,10,0,0" LineBreakMode="WordWrap"/>
                                <Button Text="{Binding [AddToFavorites], Source={x:Static strings:LocalizationResourceManager.Instance}}" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=AddToFavoritesCommand}"
                                        CommandParameter="{Binding .}"
                                        Margin="0,15,0,0"
                                        CornerRadius="10"/>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Indicators -->
        <IndicatorView x:Name="indicatorView" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                       HorizontalOptions="Center" Margin="0,10,0,10"
                       IndicatorColor="LightGray"
                       SelectedIndicatorColor="DeepSkyBlue"/>

    </Grid>

</ContentPage>
