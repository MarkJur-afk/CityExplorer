<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CityExplorer.ViewModels"
             xmlns:models="clr-namespace:CityExplorer.Models"
             xmlns:strings="clr-namespace:CityExplorer.Resources.Strings"
             x:Class="CityExplorer.Views.FavoritesPage"
             Title="{Binding [FavoritesTitle], Source={x:Static strings:LocalizationResourceManager.Instance}}">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Favorites}" Margin="10">
            <CollectionView.EmptyView>
                <Label Text="Нет сохраненных мест." HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FavoriteAttraction">
                    <Frame Margin="5" CornerRadius="10" HasShadow="True" Padding="10">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                            <Image Grid.Column="0" Source="{Binding ImageUrl}" WidthRequest="80" HeightRequest="80" Aspect="AspectFill"/>
                            <StackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="{Binding Category}" FontSize="14"/>
                            </StackLayout>
                            <Button Grid.Column="2" 
                                    Text="{Binding [Remove], Source={x:Static strings:LocalizationResourceManager.Instance}}" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=RemoveFavoriteCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="IndianRed"
                                    TextColor="White"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
