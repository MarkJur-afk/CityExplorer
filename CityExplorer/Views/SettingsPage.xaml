<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CityExplorer.ViewModels"
             xmlns:strings="clr-namespace:CityExplorer.Resources.Strings"
             x:Class="CityExplorer.Views.SettingsPage"
             Title="{Binding [SettingsTitle], Source={x:Static strings:LocalizationResourceManager.Instance}}">

    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="{Binding [SettingsTitle], Source={x:Static strings:LocalizationResourceManager.Instance}}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
        
        <Label Text="{Binding [SelectLanguage], Source={x:Static strings:LocalizationResourceManager.Instance}}" FontSize="18"/>
        
        <Picker ItemsSource="{Binding Languages}" 
                SelectedItem="{Binding SelectedLanguage}"
                Title="Выбор языка" />
    </VerticalStackLayout>

</ContentPage>
